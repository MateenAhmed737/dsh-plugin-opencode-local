{
  "name": "dsh-plugin-opencode-local",
  "version": "0.1.2",
  "description": "DeepSeek Harness (DSH) LLM provider that serves every request through your own installed OpenCode (`opencode serve`), the same way T3 Code does.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "opencode",
    "llm-provider"
  ],
  "license": "MIT",
  "author": "Mateen Ahmed (https://github.com/MateenAhmed737)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateenAhmed737/dsh-plugin-opencode-local.git"
  },
  "bugs": "https://github.com/MateenAhmed737/dsh-plugin-opencode-local/issues",
  "homepage": "https://github.com/MateenAhmed737/dsh-plugin-opencode-local#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@opencode-ai/sdk": "^1.19.5",
    "@opencode/client": "^2.2.5",
    "effect": "^4.0.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
